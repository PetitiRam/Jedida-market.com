# ============================================================
# JEDIDA Marketplace — Backend environment variables
# Copy this file to `.env` and fill in real values. Never commit
# the actual `.env` file — it holds live secrets and database
# credentials. (See note at the bottom of this file.)
# ============================================================

# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- TLS / SSL ----
# Leave all three blank to keep the current behavior (plain HTTP — correct
# when a reverse proxy like Railway/Render/Cloudflare/nginx already
# terminates HTTPS in front of this process). Set SSL_KEY_PATH + SSL_CERT_PATH
# to have this server terminate TLS itself instead (standalone VPS deploys,
# or local HTTPS dev so the native shells — which refuse cleartext traffic
# entirely — can reach it from a real device). SSL_CA_PATH is optional,
# only needed for a certificate chain your OS/device doesn't already trust.
SSL_KEY_PATH=
SSL_CERT_PATH=
SSL_CA_PATH=
# Redirect any plain-HTTP request to HTTPS. Only turn this on if this
# process itself is the one terminating TLS (see above) or you're certain
# nothing in front of it already handles the redirect — enabling it behind
# a proxy that also redirects is harmless but redundant.
FORCE_HTTPS=false

# ---- PostgreSQL ----
# The only database setting you actually need: a single connection string,
# the same format Railway/Render/Heroku/Supabase all hand you automatically
# in their dashboard (postgres://user:password@host:port/dbname). When
# this is set, everything below it is ignored.
DATABASE_URL=

# Force SSL on/off for the connection above. Leave blank: SSL turns on
# automatically for anything that isn't localhost (correct for every
# managed Postgres provider), off for a local database. Set to `false` to
# force it off (e.g. a private VPC connection to a DB with no TLS) or
# `strict` to turn on real certificate verification instead of the
# permissive default managed providers usually need.
DATABASE_SSL=

# ---- PostgreSQL (fallback — only used if DATABASE_URL above is blank) ----
# Use the EXTERNAL host/port from your Postgres provider when running this
# app outside that provider's own network (e.g. on your laptop, or a
# different host). On Render specifically: the dashboard shows both an
# "Internal Database URL" (only reachable from other Render services in the
# same region) and an "External Database URL" — use the external one here,
# and note that free-tier databases expire and get deleted after a period
# of inactivity, which changes/removes this hostname entirely.
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

# ---- Auth (JWT) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Signs the short-lived (5m) MFA challenge token issued between a correct
# password and a verified 2FA code (see POST /api/auth/2fa/login-verify).
# Falls back to JWT_ACCESS_SECRET if unset — set a distinct value in
# production so a leaked access-token secret can't also forge MFA
# challenges.
JWT_MFA_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- URLs ----
# Frontend origin — used for CORS, password-reset links, share links.
FRONTEND_URL=http://localhost:5173
# Public URL of THIS backend — used to build shareable links (e.g. /shop/:slug).
PUBLIC_API_URL=http://localhost:5000

# ---- Email (password reset, notifications) ----
# Leave SMTP_* blank to disable email sending (calls no-op instead of throwing).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="JEDIDA Marketplace <no-reply@jedida.example>"

# ---- SMS / OTP (Twilio) ----
# Leave blank to use sandbox mode — OTP codes are printed to the backend
# console instead of being sent, so local dev/testing works without an
# account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- LLM providers (Groq + Google AI Studio) ----
# Powers real AI reasoning for the in-app assistants (Nsubuga Joseph,
# Colline, PETITI, TAUSI). Leave both blank to keep the deterministic
# rule-based fallbacks. These are the only two LLM providers wired into
# this codebase (see backend/src/services/llmClient.js) — Groq is tried
# first, Google AI Studio is the fallback. Set LLM_PROVIDER=google to
# reverse that order.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_AI_STUDIO_API_KEY=
GOOGLE_AI_STUDIO_MODEL=gemini-2.0-flash
LLM_PROVIDER=groq

# ---- Google (Sign in with Google + Colline's image search) ----
# GOOGLE_CLIENT_ID is the Web OAuth client ID — must match the frontend's
# VITE_GOOGLE_CLIENT_ID exactly (the ID token's audience is checked against
# it). GOOGLE_ANDROID_CLIENT_ID / GOOGLE_IOS_CLIENT_ID are only needed if
# the mobile app uses native per-platform Google Sign-In instead of the web
# client ID. The OAuth Client *Secret* is never needed here — only ID-token
# verification is used, not the authorization-code exchange flow.
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ---- Cloudinary (image/video uploads) ----
# Leave blank and the upload endpoint returns a clear "not configured"
# error; users can still paste image/video URLs directly instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: real malware scanning for every upload (uploadSecurity.js).
# Point this at a clamd REST bridge (e.g. the "clamav-rest" project) that
# accepts a raw POST body and returns {"infected": bool, "name": string}.
# Leave blank to run heuristic signature checks only (still mandatory,
# always on) without a full AV engine.
CLAMAV_API_URL=

# ---- Payment providers ----
# Used for order checkout (Stripe/Flutterwave/DPO/Coinbase Commerce).
# The seller/delivery account UPGRADE fee itself is mobile-money based and
# does NOT use these — its per-country pricing is configured from the
# Admin Dashboard → Settings → Upgrades tab, stored in the database
# (platform_settings.seller_upgrade_settings), not in this file.
STRIPE_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
DPO_COMPANY_TOKEN=
COINBASE_COMMERCE_API_KEY=

# ---- Payment webhook signing secrets ----
# Required to actually confirm any of the above in production — see
# routes/paymentWebhooks.js. Without these set, a payment made through
# that provider will sit in pending_payment forever (by design: no
# secret means no way to verify the callback is real, so it's never
# trusted automatically). Get each value from the provider's dashboard
# webhook settings, pointed at:
#   https://<your-domain>/api/webhooks/stripe
#   https://<your-domain>/api/webhooks/flutterwave
#   https://<your-domain>/api/webhooks/coinbase
# DPO has no webhook secret — it's verified via a server-to-server
# verifyToken call using DPO_COMPANY_TOKEN above instead.
STRIPE_WEBHOOK_SECRET=
FLUTTERWAVE_WEBHOOK_SECRET=
COINBASE_COMMERCE_WEBHOOK_SECRET=

# ---- LibreTranslate (chat message translation) ----
# English/French/Swahili only — Luganda and Lusoga have no mainstream MT
# support and are marked unsupported in the UI. Leave blank to use the
# public instance at libretranslate.com (rate-limited); self-host for
# production use.
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=

# ---- Local file storage ----
# Directory for admin-triggered database backups (system_backups records).
BACKUP_DIR=./backups

# ---- Push notifications (chat messages, order/delivery updates to the mobile app) ----
# Base64-encoded Firebase service-account JSON (Firebase Console > Project
# Settings > Service Accounts > Generate new private key, then
# `base64 -w0 service-account.json`). Same Firebase project's config goes
# into the Android/iOS shell (google-services.json / GoogleService-Info.plist).
# Leave blank to run with push disabled — pushService.js logs a no-op
# instead of sending, so nothing else breaks without it configured.
FIREBASE_SERVICE_ACCOUNT=

# ============================================================
# NOTE: this project's uploaded zip contained a real `backend/.env` with
# live-looking credentials (DB password, JWT secrets, Twilio, Anthropic,
# Google, Cloudinary, payment provider keys). That file should never be
# committed to git or shared — treat every value currently in it as
# compromised and rotate it (new DB password, new JWT secrets, new API
# keys) before deploying again. Add `.env` to `.gitignore` if it isn't
# already, and keep only this `.env.example` (with blank values) in
# version control.
# ============================================================
