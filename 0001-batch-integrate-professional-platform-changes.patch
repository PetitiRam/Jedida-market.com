+          transactionType: 'pos_payment',
+          status: 'succeeded',
+          source: 'pos',
+          amount: lineTotal,
+          feeAmount: platformFeeAmount,
+          netAmount: sellerPayable,
+          currency: product.currency,
+          orderId: order.id,
+          orderPublicRef: order.public_ref,
+          sellerId,
+          shopId,
+          actorId: req.user.id,
+          destinationWalletId: sellerWallet.rows[0].id,
+          paymentMethod,
