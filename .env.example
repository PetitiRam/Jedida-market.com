# Database
DATABASE_URL=postgresql://user:password@localhost:5432/jedida_marketplace
DATABASE_SSL=false

# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# JWT & Auth
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-too

# Cloudinary (Media Upload)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ClamAV (Optional: Malware scanning)
CLAMSCAN_BIN=/usr/bin/clamscan
CLAMAV_ENABLED=false

# Optional: SSL/TLS direct termination (most deployments use a proxy instead)
SSL_KEY_PATH=
SSL_CERT_PATH=
SSL_CA_PATH=
FORCE_HTTPS=false

# Background sweeps
ESCROW_AUTO_RELEASE_DISABLED=false
ESCROW_AUTO_RELEASE_INTERVAL_MS=3600000
AGRI_CONTRACT_SWEEP_DISABLED=false
AGRI_CONTRACT_SWEEP_INTERVAL_MS=86400000
VERIFIED_SHOP_SWEEP_DISABLED=false
VERIFIED_SHOP_SWEEP_INTERVAL_MS=21600000
