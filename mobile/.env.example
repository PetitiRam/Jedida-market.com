# ============================================================
# JEDIDA Marketplace — Mobile (Expo) environment variables
# Copy to `.env` in the mobile/ folder. EXPO_PUBLIC_ vars are inlined at
# build time and visible in the shipped app — do not put secrets here.
# ============================================================

# Backend API base URL the mobile app talks to.
# Use your machine's LAN IP (not localhost) when testing on a physical
# device via Expo Go, e.g. http://192.168.1.20:5000/api
EXPO_PUBLIC_API_URL=http://localhost:5000/api
