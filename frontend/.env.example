# Backend API base URL (defaults to /api if unset — see src/api/client.js)
VITE_API_URL=/api

# Google OAuth Web Client ID — must be the SAME client ID configured as
# GOOGLE_CLIENT_ID on the backend (the ID token's audience is checked
# against that value). Safe to expose to the frontend; it is a public
# identifier, not a secret. Get it from Google Cloud Console →
# APIs & Services → Credentials → OAuth 2.0 Client IDs → Web application.
# Add this app's origin (e.g. http://localhost:5173 and your production
# domain) to that client's "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=

# Android APK download link + version shown on the "Get the app" download
# page. Leave blank to hide that download prompt.
VITE_APK_DOWNLOAD_URL=
VITE_APK_VERSION=
