<!-- Place at android/app/src/main/res/xml/network_security_config.xml -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Only these domains are reachable from the WebView / native HTTP
         stack. Anything else is refused at the OS level, independent of
         the JS-side allowNavigation check in capacitor.config.ts. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">jedidamarketplace.com</domain>
    </domain-config>
</network-security-config>
